---
/**
 * AdsterraSlotPair — the standard two-position Adsterra mount shared by the
 * content pages: a fixed 728×90 banner (hidden on mobile — fixed creatives
 * clip in narrow iframes) before the content, and the responsive native
 * banner (fills any width, covers mobile) at the end of it.
 *
 *   <AdsterraSlotPair>
 *     ...page content shown between the two units...
 *   </AdsterraSlotPair>
 *
 * Content that must render AFTER the native banner goes in the `after`
 * slot (the landing root's FinalCta keeps its pre-banner position that way):
 *
 *   <AdsterraSlotPair>
 *     <CommunitySites t={t} />
 *     <Fragment slot="after"><FinalCta t={t} /></Fragment>
 *   </AdsterraSlotPair>
 *
 * DOM order is always banner → default slot → native → after slot, so every
 * page renders byte-equivalent to the previously hand-written pairs (modulo
 * AdsterraSlot's own consent-gated deferred load). All call sites used
 * identical props on both units, so the pair takes none — the slot names and
 * sizes are pinned here once. Docs-center pages that mount ONLY the native
 * banner keep a direct <AdsterraSlot name="native-banner"> — not a pair.
 *
 * Consent-gated deferred loading lives inside AdsterraSlot; the pair
 * inherits it by composition (no logic duplicated here).
 */
import AdsterraSlot from './AdsterraSlot.astro';
---

<AdsterraSlot name="incontent-728x90" width={728} height={90} hideOnMobile />
<slot />
<AdsterraSlot name="native-banner" width={700} height={240} />
<slot name="after" />
