---
/**
 * Theme toggle — cycles light → dark → AMOLED black.
 * Pure vanilla JS, no framework runtime. Classes live on <html>:
 *   light: (none) · dark: .dark · black: .dark.black (black = dark vars
 *   overridden with pure-black surfaces in globals.css for OLED phones).
 * The stored value ('light'|'dark'|'black') is re-applied pre-paint in
 * BaseLayout's no-FOUC script.
 */
import { Icon } from 'astro-icon/components';
import { currentSharedStrings } from '~/lib/shared-ui';

const sharedStrings = currentSharedStrings(Astro.currentLocale);
const toggleTheme = sharedStrings.toggleTheme ?? 'Cycle theme (light / dark / AMOLED black)';
const themeTitle = sharedStrings.themeToggleTitle ?? 'Light / Dark / AMOLED black';
---

<button
  id="theme-toggle"
  type="button"
  aria-label={toggleTheme}
  title={themeTitle}
  class="inline-flex h-9 w-9 items-center justify-center rounded-md text-foreground transition hover:bg-muted"
>
  <Icon name="lucide:sun" data-theme-icon="light" class="h-5 w-5" />
  <Icon name="lucide:moon" data-theme-icon="dark" class="h-5 w-5" />
  <Icon name="lucide:contrast" data-theme-icon="black" class="h-5 w-5" />
</button>

<style is:global>
  /* Show only the icon matching the current theme state. */
  [data-theme-icon] {
    display: none;
  }
  html:not(.dark) [data-theme-icon='light'] {
    display: inline-flex;
  }
  html.dark:not(.black) [data-theme-icon='dark'] {
    display: inline-flex;
  }
  html.black [data-theme-icon='black'] {
    display: inline-flex;
  }
</style>

<script is:inline>
  /* ES2018 only — untranspiled inline script, parsed by old webviews. */
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.classList.contains('black')
        ? 'black'
        : html.classList.contains('dark')
          ? 'dark'
          : 'light';
      const next = current === 'light' ? 'dark' : current === 'dark' ? 'black' : 'light';
      html.classList.toggle('dark', next !== 'light');
      html.classList.toggle('black', next === 'black');
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage unavailable — session-only theme */
      }
    });
  })();
</script>
