---
/**
 * LandingHero — the hero section of the project landing page.
 *
 * Left: badge + H1 + subtitle + 3 CTAs + install command block (with copy).
 * Right: browser mockup frame with a text placeholder (screenshots later).
 *
 * The H1 carries the "repositioning narrative" — it must say "100% ad revenue"
 * in the first screen so users don't confuse this with Fandom-style wikis.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<section class="section overflow-hidden">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    {/* Left: copy + CTAs — min-w-0 keeps the unbreakable install-command
        <pre> (white-space:pre min-content = longest line) from stretching
        this grid item past the viewport on mobile, which silently clipped
        the CTAs off-screen. */}
    <div class="min-w-0">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
        {t.hero.badge}
      </span>

      <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-foreground sm:text-5xl">
        {t.hero.title}
      </h1>

      <p class="mt-5 max-w-xl text-lg text-muted-foreground">
        {t.hero.subtitle}
      </p>

      {/* CTAs */}
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={t.hero.primaryCta.href} class="btn-primary inline-flex items-center gap-1.5">
          <Icon name="lucide:rocket" class="h-4 w-4" />
          {t.hero.primaryCta.label}
        </a>
        <a
          href={t.hero.secondaryCta.href}
          class="btn-outline inline-flex items-center gap-1.5"
          target="_blank"
          rel="noopener"
        >
          <Icon name="lucide:star" class="h-4 w-4" />
          {t.hero.secondaryCta.label}
        </a>
        <a href={t.hero.tertiaryCta.href} class="inline-flex items-center gap-1.5 text-sm font-medium text-nav transition hover:underline">
          {t.hero.tertiaryCta.label}
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>

      {/* Install command block */}
      <div class="mt-7 max-w-lg">
        <div class="flex items-center gap-2 rounded-t-lg border border-b-0 border-border bg-muted px-4 py-2">
          <Icon name="lucide:terminal" class="h-4 w-4 text-muted-foreground" />
          <span class="text-xs font-medium text-muted-foreground">{t.hero.terminalLabel}</span>
          <button
            id="copy-install"
            class="ml-auto inline-flex items-center gap-1 text-xs text-muted-foreground transition hover:text-foreground"
            aria-label={t.hero.copyLabel}
            data-copied-label={t.hero.copiedLabel}
          >
            <Icon name="lucide:copy" class="h-3.5 w-3.5" />
            <span>{t.hero.copyLabel}</span>
          </button>
        </div>
        <pre class="overflow-x-auto rounded-b-lg border border-border bg-card p-4 text-sm leading-relaxed text-foreground"><code id="install-code">{t.hero.installCommand}</code></pre>
      </div>
    </div>

    {/* Right: real demo screenshot in a browser frame */}
    <div class="hidden lg:block">
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-lg">
        {/* Browser chrome */}
        <div class="flex items-center gap-2 border-b border-border bg-muted px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
          <span class="h-3 w-3 rounded-full bg-green-400"></span>
          <span class="ml-3 truncate rounded bg-background px-3 py-0.5 text-xs text-muted-foreground">
            anvil.wiki
          </span>
        </div>
        <a href={t.hero.tertiaryCta.href}>
          {/* Above-fold LCP candidate on lg+ viewports — eager + high
              priority; WebP keeps it ~23K. */}
          <img
            src="/images/showcase/demo-home.webp"
            alt={t.hero.screenshotAlt}
            width="1280"
            height="800"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full"
          />
        </a>
      </div>
      <p class="mt-3 text-center text-xs text-muted-foreground">
        {t.hero.screenshotCaption}
      </p>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-install');
  const codeEl = document.getElementById('install-code');
  if (copyBtn && codeEl) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeEl.textContent || '');
        const label = copyBtn.querySelector('span');
        if (label) {
          const original = label.textContent;
          label.textContent = copyBtn.dataset.copiedLabel || 'Copied!';
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        }
      } catch {
        // Clipboard API not available — silently ignore.
      }
    });
  }
</script>
