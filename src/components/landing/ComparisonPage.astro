---
/**
 * ComparisonPage — the standalone "AnvilWiki vs Fandom vs Wiki.js" page
 * (/landing/comparison + /zh/landing/comparison).
 *
 * Catches comparison-intent search ("which wiki tool should I pick") and
 * hands AI engines citable facts. The engine table stays neutral on purpose
 * (no digs at competitors — alphabetical, facts only); the honesty about our
 * own small star count IS the positioning. All copy lives in landing.ts
 * (`comparisonPage`); apply-template removes the whole landing layer.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const c = t.comparisonPage;
const TLDR_ICONS = ['lucide:building-2', 'lucide:server', 'lucide:hammer'];
const FANDOM_ICONS = ['lucide:layout-template', 'lucide:badge-dollar-sign', 'lucide:globe', 'lucide:bot'];
---

<section class="section" data-pagefind-body>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">{c.title}</h1>
    <p class="mt-3 text-lg text-muted-foreground">{c.intro}</p>

    <!-- The three species -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight text-foreground">{c.tldrTitle}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {c.tldrItems.map((item, i) => (
        <div class="rounded-lg border border-border bg-muted/40 p-4">
          <div class="flex items-center gap-2 font-semibold text-foreground">
            <Icon name={TLDR_ICONS[i]} class="h-4 w-4 shrink-0 text-nav" />
            {item.name}
          </div>
          <p class="mt-2 text-sm text-muted-foreground">{item.text}</p>
        </div>
      ))}
    </div>

    <!-- Core comparison (AnvilWiki column highlighted, same as homepage table) -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight text-foreground">{c.table.title}</h2>
    <p class="mt-2 text-muted-foreground">{c.table.subtitle}</p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="p-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground"></th>
            {c.table.columns.map((col, i) => (
              <th
                class:list={[
                  'p-3 text-center font-semibold',
                  i === 0
                    ? 'rounded-t-lg bg-nav/10 text-nav'
                    : 'text-foreground',
                ]}
              >
                {col}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {c.table.rows.map((row) => (
            <tr class="border-b border-border/50">
              <td class="p-3 text-left font-medium text-muted-foreground">{row.label}</td>
              {row.values.map((value, i) => (
                <td
                  class:list={[
                    'p-3 text-center',
                    i === 0 ? 'bg-nav/5 font-medium text-foreground' : 'text-muted-foreground',
                  ]}
                >
                  {value}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Why Fandom users switch (long-tail intent: Fandom template/ads/domain limits) -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight text-foreground">{c.fandomSwitch.title}</h2>
    <p class="mt-2 text-muted-foreground">{c.fandomSwitch.subtitle}</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {c.fandomSwitch.items.map((item, i) => (
        <div class="rounded-lg border border-border bg-muted/40 p-4">
          <div class="flex items-center gap-2 font-semibold text-foreground">
            <Icon name={FANDOM_ICONS[i]} class="h-4 w-4 shrink-0 text-nav" />
            {item.title}
          </div>
          <p class="mt-2 text-sm text-muted-foreground">{item.text}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 flex items-start gap-2 text-sm text-muted-foreground">
      <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0 text-nav" />
      {c.fandomSwitch.note}
    </p>

    <!-- Self-hosted engines, neutral facts -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight text-foreground">{c.engines.title}</h2>
    <p class="mt-2 text-muted-foreground">{c.engines.subtitle}</p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-border">
            {c.engines.columns.map((col) => (
              <th class="p-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                {col}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {c.engines.entries.map((e) => (
            <tr class="border-b border-border/50">
              <td class="p-3 font-medium text-foreground">
                <a href={e.url} target="_blank" rel="noopener" class="transition hover:text-nav">
                  {e.name}
                </a>
              </td>
              <td class="p-3 text-muted-foreground">{e.positioning}</td>
              <td class="p-3 text-muted-foreground">{e.license}</td>
              <td class="p-3 text-muted-foreground">{e.stars}</td>
              <td class="p-3 text-muted-foreground">{e.release}</td>
              <td class="p-3 text-muted-foreground">{e.bestFor}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 flex items-start gap-2 text-sm text-muted-foreground">
      <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0 text-nav" />
      {c.engines.note}
    </p>

    <!-- When NOT to pick AnvilWiki -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight text-foreground">{c.notFor.title}</h2>
    <p class="mt-2 text-muted-foreground">{c.notFor.subtitle}</p>
    <div class="mt-5 space-y-3">
      {c.notFor.items.map((item) => (
        <div
          class="flex flex-col gap-1 rounded-lg border border-border p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
        >
          <span class="text-sm text-foreground">{item.need}</span>
          <span class="flex shrink-0 items-center gap-1.5 text-sm font-semibold text-nav">
            <Icon name="lucide:arrow-right" class="h-4 w-4 shrink-0" />
            {item.pick}
          </span>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 rounded-xl border border-border bg-nav/5 p-8 text-center">
      <h2 class="text-2xl font-extrabold tracking-tight text-foreground">{c.cta.title}</h2>
      <p class="mt-2 text-muted-foreground">{c.cta.subtitle}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={c.cta.primaryHref} class="btn-primary inline-flex items-center gap-1.5">
          <Icon name="lucide:external-link" class="h-4 w-4" />
          {c.cta.primaryLabel}
        </a>
        <a href={c.cta.secondaryHref} class="btn-outline inline-flex items-center gap-1.5">
          {c.cta.secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
