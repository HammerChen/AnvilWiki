---
/**
 * Community — floating WeChat QR widget pinned to the bottom-right of the
 * landing pages. The QR card is OPEN by default on desktop (sm+, ≥640px) so
 * visitors see it without interacting; on phones it starts COLLAPSED (the
 * 288px card covered ~77% of a 390px viewport on load) and the
 * brand-colored pill below opens it (Esc / outside click / X also close).
 * The QR image lives at /images/wechat-qr.jpg (project asset, removed from
 * forks together with the rest of the landing page by apply-template).
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<div class="community-float" data-community-float>
  {/* QR card — open by default; the pill toggles it */}
  <div
    id="community-qr-panel"
    data-qr-panel
    role="dialog"
    aria-modal="false"
    aria-label={t.community.title}
    hidden
    class="absolute bottom-full right-0 mb-3 w-72 rounded-lg border border-border bg-card p-4 text-card-foreground shadow-xl"
  >
    <button
      type="button"
      data-qr-close
      aria-label={t.community.closeAria}
      class="absolute right-2 top-2 rounded-md p-1 text-muted-foreground transition hover:bg-muted hover:text-foreground"
    >
      <Icon name="lucide:x" class="h-4 w-4" />
    </button>
    <h2 class="pr-6 text-sm font-bold text-foreground">{t.community.title}</h2>
    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">{t.community.subtitle}</p>
    <img
      src="/images/wechat-qr.jpg"
      alt={t.community.qrAlt}
      width="480"
      height="693"
      loading="lazy"
      decoding="async"
      class="mx-auto mt-3 w-40 rounded-md"
    />
    <p class="mt-2 flex items-center justify-center gap-1 text-xs font-medium text-nav">
      <Icon name="lucide:qr-code" class="h-3.5 w-3.5" />
      {t.community.qrCaption}
    </p>
    <p class="mt-1 flex items-center justify-center gap-1 text-xs text-muted-foreground">
      <Icon name="lucide:message-circle" class="h-3.5 w-3.5" />
      {t.community.qrNote}
    </p>
  </div>

  {/* Always-visible pill (toggles the card; JS opens the card on desktop) */}
  <button
    type="button"
    data-qr-toggle
    aria-expanded="false"
    aria-controls="community-qr-panel"
    class="btn-fab relative"
  >
    <span class="pulse-ring" aria-hidden="true"></span>
    <Icon name="lucide:qr-code" class="relative h-4 w-4" />
    <span class="relative">{t.community.buttonLabel}</span>
  </button>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-community-float]');
    if (!root) return;
    const btn = root.querySelector('[data-qr-toggle]');
    const panel = root.querySelector('[data-qr-panel]');
    const closeBtn = root.querySelector('[data-qr-close]');
    const setOpen = (open) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    // Card ships hidden (no-JS stays collapsed); desktop auto-opens it.
    // No-JS desktop losing the auto-open is the accepted tradeoff for
    // phones not getting a viewport-sized card in the face.
    if (!window.matchMedia('(max-width: 639px)').matches) setOpen(true);
    btn.addEventListener('click', () => setOpen(panel.hidden));
    closeBtn.addEventListener('click', () => {
      setOpen(false);
      btn.focus();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !root.contains(e.target)) setOpen(false);
    });
  })();
</script>

<style>
  /* Fixed bottom-right; safe-area keeps clear of the iOS home indicator. */
  .community-float {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 50;
  }
  @media (min-width: 640px) {
    .community-float {
      right: 1.5rem;
      bottom: calc(1.5rem + env(safe-area-inset-bottom));
    }
  }
  /* Soft attention ring — plays 3 times, then stops; disabled for reduced motion. */
  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid hsl(var(--brand));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse-ring {
      animation: community-ping 2s ease-out 3;
    }
  }
  @keyframes community-ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    75%,
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }
</style>
