{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anvil.wiki/docs/home.schema.json",
  "title": "AnvilWiki locale JSON (home namespace)",
  "description": "Add \"$schema\": \"./docs/home.schema.json\" to src/locales/<locale>.json for editor validation. The 6 supported explore displayTypes are enforced; all other keys are structural hints.",
  "type": "object",
  "properties": {
    "site": { "type": "object" },
    "nav": { "type": "object", "additionalProperties": { "type": "string" } },
    "overview": { "type": "object" },
    "footer": { "type": "object" },
    "shared": { "type": "object" },
    "home": {
      "type": "object",
      "required": ["hero", "start", "explore"],
      "properties": {
        "meta": {
          "type": "object",
          "properties": { "watermark": { "type": "string" } }
        },
        "hero": {
          "type": "object",
          "required": ["title", "description", "ctaPrimary"],
          "properties": {
            "badge": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string", "minLength": 20 },
            "ctaPrimary": { "$ref": "#/$defs/cta" },
            "ctaSecondary": { "$ref": "#/$defs/cta" },
            "videoId": { "type": "string", "description": "YouTube video ID — hero video is lazy-loaded, leave empty for none." }
          }
        },
        "updates": {
          "type": "object",
          "properties": {
            "badge": { "type": "string" },
            "title": { "type": "string" }
          }
        },
        "start": {
          "type": "object",
          "required": ["title", "cards"],
          "properties": {
            "badge": { "type": "string" },
            "title": { "type": "string" },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "description", "icon", "href"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "icon": { "type": "string", "examples": ["lucide:gift", "lucide:swords", "lucide:book-open"] },
                  "href": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        },
        "popular": {
          "type": "object",
          "properties": {
            "badge": { "type": "string" },
            "title": { "type": "string" },
            "quickLinks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "href"],
                "properties": {
                  "label": { "type": "string" },
                  "href": { "type": "string" }
                }
              }
            }
          }
        },
        "explore": {
          "type": "object",
          "required": ["title", "modules"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["order", "name", "href", "displayType", "highlights"],
                "properties": {
                  "order": { "type": "number" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "href": { "type": "string", "pattern": "^/" },
                  "displayType": {
                    "type": "string",
                    "enum": ["badge-list", "steps", "ranked-grid", "labeled-cards", "timeline", "video-grid"],
                    "description": "badge-list (codes) · steps (progression) · ranked-grid (tier lists) · labeled-cards (item cards) · timeline (patch notes) · video-grid (thumbnails that LINK OUT, never embed)"
                  },
                  "highlights": {
                    "type": "array",
                    "description": "Fields depend on displayType — see src/components/home/modules/*.",
                    "items": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "faq": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["question", "answer"],
                "properties": {
                  "question": { "type": "string" },
                  "answer": { "type": "string" }
                }
              }
            }
          }
        },
        "closingCta": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "primary": { "$ref": "#/$defs/cta" },
            "secondary": { "$ref": "#/$defs/cta" }
          }
        }
      }
    }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string" }
      }
    }
  }
}
